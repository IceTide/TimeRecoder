{
  "name": "timerecoder",
  "version": "0.1.0",
  "private": true,
  "description": "本地优先的桌面时间管理应用",
  "author": "Liu Yisong",
  "license": "Apache-2.0",
  "keywords": [
    "time-tracking",
    "focus",
    "pomodoro",
    "productivity",
    "electron",
    "local-first",
    "time-management"
  ],
  "homepage": "https://github.com/IceTide/TimeRecoder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IceTide/TimeRecoder.git"
  },
  "bugs": {
    "url": "https://github.com/IceTide/TimeRecoder/issues"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && node scripts/start-electron.cjs",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "start": "node scripts/start-electron.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false && tsc -p tsconfig.node.json --noEmit --pretty false && tsc -p tsconfig.electron.json --noEmit --pretty false"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
